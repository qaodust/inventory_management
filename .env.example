# Copy to .env and fill in with a real connection string.
# For the shared dev database, get this from:
#   railway variables --service Postgres
# (use DATABASE_PUBLIC_URL locally; the app itself uses the private
# DATABASE_URL when deployed on Railway)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Same connection as above, but with a different Postgres schema
# (?schema=test) so the automated test suite never touches real
# business data. Required to run `npm test`.
TEST_DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=test"

# Auth.js session-signing secret. Generate with `npx auth secret` or
# `openssl rand -base64 33`. Keep this identical across dev/prod only if
# you want sessions to remain valid across environments (they don't need
# to match here since dev and prod share one Railway database).
AUTH_SECRET="replace-with-a-generated-secret"

# Credentials for the one-time account seed script (prisma/seed.ts).
# These are TEMPORARY passwords — each owner changes their own password
# via the in-app /account screen immediately after first login. Never
# commit real values here; this file only documents the variable names.
OWNER1_EMAIL="owner1@example.com"
OWNER1_PASSWORD="replace-with-a-temporary-password"
OWNER2_EMAIL="owner2@example.com"
OWNER2_PASSWORD="replace-with-a-temporary-password"
