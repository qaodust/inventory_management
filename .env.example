# Copy to .env and fill in with a real connection string.
# For the shared dev database, get this from:
#   railway variables --service Postgres
# (use DATABASE_PUBLIC_URL locally; the app itself uses the private
# DATABASE_URL when deployed on Railway)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Same connection as above, but with a different Postgres schema
# (?schema=test) so the automated test suite never touches real
# business data. Required to run `npm test`.
TEST_DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=test"
